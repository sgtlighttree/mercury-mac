{
  "name": "mercury-mac",
  "productName": "Messenger",
  "private": true,
  "version": "0.1.0",
  "description": "Lightweight macOS desktop client for Facebook Messenger",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && esbuild src/preload/index.ts --bundle --outfile=dist/preload/index.js --external:electron --format=cjs --platform=browser",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "typescript": "~5.6.2",
    "vitest": "^2.1.0"
  }
}
