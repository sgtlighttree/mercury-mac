{
  "name": "mercury-mac",
  "productName": "Messenger",
  "private": true,
  "version": "0.1.0",
  "description": "Lightweight macOS desktop client for Facebook Messenger",
  "license": "MIT",
  "main": "dist/main/index.js",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc --noEmit && tsc -p tsconfig.build.json && esbuild src/preload/index.ts --bundle --outfile=dist/preload/index.js --external:electron --format=cjs --platform=browser",
    "start": "pnpm run build && electron .",
    "test": "vitest run",
    "dist": "pnpm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^43.3.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "typescript": "~5.6.2",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.mercury.messenger",
    "productName": "Messenger",
    "electronLanguages": [
      "en"
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "timestamp": "none",
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Messenger uses your camera for video calls.",
        "NSMicrophoneUsageDescription": "Messenger uses your microphone for calls.",
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": false }
      }
    }
  }
}
